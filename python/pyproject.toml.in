[build-system]
requires = ["setuptools>=61", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "@NATIVE_LIBRARY_NAME@"
version = "@PYTHON_PACKAGE_VERSION@"
description = "Python bindings for @NATIVE_LIBRARY_NAME@."
requires-python = ">=3.12"
license = {text = "MIT"}
authors = [
  {name = "@NATIVE_LIBRARY_NAME@ contributors"}
]

[tool.setuptools]
packages = ["@PROJECT_NAME@"]
include-package-data = true

[tool.setuptools.package-data]
"@PROJECT_NAME@" = ["*.so", "*.so.*", "*.pyd", "*.dll", "*.dylib", "*.pyi", "**/*.pyi"]
