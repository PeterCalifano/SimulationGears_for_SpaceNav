# Validate exact-release source artifacts only while CPack runs a source generator.

if(NOT DEFINED CPACK_SOURCE_INSTALLED_DIRECTORIES OR
   "${CPACK_SOURCE_INSTALLED_DIRECTORIES}" STREQUAL "")
  return()
endif()

if(NOT "@PROJECT_VERSION_IS_EXACT_CLEAN_GIT_TAG@" STREQUAL "TRUE")
  return()
endif()

set(_source_version_file "@CMAKE_CURRENT_SOURCE_DIR@/VERSION")
if(NOT EXISTS "${_source_version_file}")
  message(FATAL_ERROR
    "Exact release @FULL_VERSION@ requires a generated source VERSION. "
    "Run ./generate_version.sh --sync-ros2 before package_source.")
endif()

file(STRINGS "${_source_version_file}" _source_version_core_lines
     REGEX "^Project version core: .+$")
list(LENGTH _source_version_core_lines _source_version_core_count)
if(NOT _source_version_core_count EQUAL 1)
  message(FATAL_ERROR
    "Exact release source VERSION must contain one Project version core field")
endif()
list(GET _source_version_core_lines 0 _source_version_core_line)
string(REGEX REPLACE "^Project version core: " ""
       _source_version_core "${_source_version_core_line}")
if(NOT "${_source_version_core}" STREQUAL "@PROJECT_VERSION_CORE@")
  message(FATAL_ERROR
    "Exact release source VERSION core '${_source_version_core}' does not "
    "match Git-resolved core '@PROJECT_VERSION_CORE@'")
endif()

file(STRINGS "${_source_version_file}" _source_full_version_lines
     REGEX "^Full version: .+$")
list(LENGTH _source_full_version_lines _source_full_version_count)
if(NOT _source_full_version_count EQUAL 1)
  message(FATAL_ERROR
    "Exact release source VERSION must contain one Full version field")
endif()
list(GET _source_full_version_lines 0 _source_full_version_line)
string(REGEX REPLACE "^Full version: " ""
       _source_full_version "${_source_full_version_line}")
if(NOT "${_source_full_version}" STREQUAL "@FULL_VERSION@")
  message(FATAL_ERROR
    "Exact release source VERSION full version '${_source_full_version}' does "
    "not match Git-resolved full version '@FULL_VERSION@'")
endif()
